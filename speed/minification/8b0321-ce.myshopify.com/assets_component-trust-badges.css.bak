.cart-trust-badges{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}


.trust-badge-item{
    text-align:center;
        border-radius: 8px;
    border: 1px solid;
    padding: 12px;
    border-color: #ECECED;
}

.trust-badge-item img{
    margin :0 auto 10px;
}

.trust-badge-icon {
  width: 32px;
  height: 32px;
  object-fit: contain;
}

.trust-badge-item__title{
font-family: Kanit, sans-serif;
font-size:12px;
font-weight:500;
}
.trust-badge-item__info{
font-size:12px;
}