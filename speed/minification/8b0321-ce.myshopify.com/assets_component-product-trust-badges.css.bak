
.product-trust-badges {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 7px 0;

}

.product-trust-badges__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 12px;
  text-align: center;
  border-right: 1px solid #e6e6e6;
}

.product-trust-badges__item:last-child {
  border-right: none;
}

.product-trust-badges__icon {
  width: 22px;
  height: 22px;
  margin-bottom: 10px;
}

.product-trust-badges__icon img {
  display: block;
  width: 25px;
  height: 100%;
  object-fit: contain;
}

.product-trust-badges__title {
  font-size: 12px;
  font-weight: 400;
  line-height: 1.3;
  color: #3E3E47;
   margin-top: 4px;

}

.product-trust-badges__text {
  margin-top: 1px;
  font-size: 10px;
  line-height: 1.4;
  color: #B4B4C0;
}

