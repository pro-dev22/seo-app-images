document.addEventListener("DOMContentLoaded",()=>{if("undefined"==typeof gsap)return;gsap.registerPlugin(ScrollTrigger);const r=.7,t="power3.out",a="top 85%";function e(r){const t=[...r.classList].find(r=>r.startsWith("delay-"));if(!t)return 0;return.1*parseInt(t.replace("delay-",""),10)}function s(t){return t.classList.contains("duration-fast")?.4:t.classList.contains("duration-slow")?1:r}function o(r,o){gsap.utils.toArray(r).forEach(r=>{gsap.from(r,{...o,opacity:0,duration:s(r),delay:e(r),ease:t,scrollTrigger:{trigger:r,start:a,once:!0}})})}o(".fade",{}),o(".fade-up",{y:30}),o(".fade-down",{y:-30}),o(".fade-left",{x:-40}),o(".fade-right",{x:40}),o(".scale-in",{scale:.96}),o(".zoom-out",{scale:1.08}),o(".rotate-in",{rotation:8,scale:.95}),o(".blur-in",{filter:"blur(12px)",y:20}),gsap.utils.toArray(".stagger").forEach(e=>{gsap.from(e.children,{opacity:0,y:30,stagger:.12,duration:r,ease:t,scrollTrigger:{trigger:e,start:a,once:!0}})}),gsap.utils.toArray(".parallax").forEach(r=>{gsap.to(r,{yPercent:15,ease:"none",scrollTrigger:{trigger:r,scrub:!0}})})});